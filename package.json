{
  "name": "inline-diff-review",
  "displayName": "Inline Diff Review for Claude Code",
  "description": "以 diff 編輯器（左右並排／上下排）或行內紅綠標示審查 Claude Code 的修改，逐段保留 / 復原，並在聊天視窗下方列出已變更檔案（類似 GitHub Copilot）",
  "version": "0.5.1",
  "publisher": "william0214",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/william0214/claude-inline-diff.git"
  },
  "bugs": {
    "url": "https://github.com/william0214/claude-inline-diff/issues"
  },
  "homepage": "https://github.com/william0214/claude-inline-diff#readme",
  "keywords": [
    "claude",
    "claude code",
    "diff",
    "review",
    "copilot",
    "inline diff"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeInlineDiff",
          "title": "AI 修改審查",
          "icon": "media/review.svg",
          "when": "!claudeInlineDiff.hasClaudeCode"
        }
      ]
    },
    "views": {
      "claudeInlineDiff": [
        {
          "type": "webview",
          "id": "claudeInlineDiff.changedFiles",
          "name": "已變更檔案",
          "when": "!claudeInlineDiff.hasClaudeCode"
        }
      ],
      "claude-sidebar-secondary": [
        {
          "type": "webview",
          "id": "claudeInlineDiff.changedFilesInClaude",
          "name": "已變更檔案",
          "when": "claudeInlineDiff.hasClaudeCode && !claude-code:doesNotSupportSecondarySidebar"
        }
      ],
      "claude-sidebar": [
        {
          "type": "webview",
          "id": "claudeInlineDiff.changedFilesInClaudeLegacy",
          "name": "已變更檔案",
          "when": "claudeInlineDiff.hasClaudeCode && claude-code:doesNotSupportSecondarySidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeInlineDiff.installHook",
        "title": "Inline Diff: 安裝 Claude Code hook 到此工作區"
      },
      {
        "command": "claudeInlineDiff.acceptFile",
        "title": "Inline Diff: 保留此檔案全部修改",
        "icon": "$(check)"
      },
      {
        "command": "claudeInlineDiff.rejectFile",
        "title": "Inline Diff: 復原此檔案全部修改",
        "icon": "$(discard)"
      },
      {
        "command": "claudeInlineDiff.acceptAll",
        "title": "Inline Diff: 保留所有檔案的修改",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeInlineDiff.rejectAll",
        "title": "Inline Diff: 復原所有檔案的修改",
        "icon": "$(discard)"
      },
      {
        "command": "claudeInlineDiff.nextHunk",
        "title": "Inline Diff: 下一處修改"
      },
      {
        "command": "claudeInlineDiff.prevHunk",
        "title": "Inline Diff: 上一處修改"
      },
      {
        "command": "claudeInlineDiff.listFiles",
        "title": "Inline Diff: 列出所有待審查檔案"
      },
      {
        "command": "claudeInlineDiff.compareFile",
        "title": "Inline Diff: 以 diff 編輯器審查此檔案"
      },
      {
        "command": "claudeInlineDiff.toggleLayout",
        "title": "Inline Diff: 切換左右並排 / 上下排",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "claudeInlineDiff.startManualReview",
        "title": "Inline Diff: 從目前內容開始追蹤此檔案（手動審查模式）"
      },
      {
        "command": "claudeInlineDiff.showDeleted",
        "title": "Inline Diff: 顯示刪除內容"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeInlineDiff.showDeleted",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "claudeInlineDiff.acceptFile",
          "when": "claudeInlineDiff.inReviewDiff",
          "group": "navigation@2"
        },
        {
          "command": "claudeInlineDiff.rejectFile",
          "when": "claudeInlineDiff.inReviewDiff",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "claudeInlineDiff.acceptAll",
          "when": "view =~ /^claudeInlineDiff.changedFiles/",
          "group": "navigation@1"
        },
        {
          "command": "claudeInlineDiff.rejectAll",
          "when": "view =~ /^claudeInlineDiff.changedFiles/",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Inline Diff Review",
      "properties": {
        "claudeInlineDiff.reviewMode": {
          "type": "string",
          "enum": [
            "diff",
            "inline"
          ],
          "enumDescriptions": [
            "只要檔案有待審查的 AI 修改，就以「AI 修改」畫面開啟：AI 刪掉的行是紅色列、新增的行是綠色列（類似 GitHub Copilot），審查完自動回到一般分頁",
            "直接在一般分頁中以精簡標示審查（刪除內容以紅線＋hover 顯示）"
          ],
          "default": "diff",
          "description": "有待審查 AI 修改的檔案要用哪種方式顯示"
        },
        "claudeInlineDiff.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "AI 修改檔案後，自動在編輯器開啟該檔案並定位到修改處（預設關閉，可從「已變更檔案」清單開啟）"
        }
      }
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true,
      "diffEditor.renderSideBySide": false
    },
    "keybindings": [
      {
        "command": "claudeInlineDiff.acceptFile",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeInlineDiff.rejectFile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeInlineDiff.nextHunk",
        "key": "alt+f5",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeInlineDiff.prevHunk",
        "key": "shift+alt+f5",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --no-dependencies",
    "test": "npm run compile && node test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}

{
  "name": "claude-inline-diff",
  "displayName": "Claude Inline Diff",
  "description": "在原始檔案編輯器內審查 Claude Code 的修改：新增綠色、刪除處紅線＋完整內容 hover，逐段保留 / 復原，並在 Claude Code 聊天視窗下方顯示已變更檔案清單（類似 GitHub Copilot）",
  "version": "0.4.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeInlineDiff",
          "title": "Claude 修改審查",
          "icon": "media/review.svg",
          "when": "!claudeInlineDiff.hasClaudeCode"
        }
      ]
    },
    "views": {
      "claudeInlineDiff": [
        {
          "type": "webview",
          "id": "claudeInlineDiff.changedFiles",
          "name": "已變更檔案",
          "when": "!claudeInlineDiff.hasClaudeCode"
        }
      ],
      "claude-sidebar-secondary": [
        {
          "type": "webview",
          "id": "claudeInlineDiff.changedFilesInClaude",
          "name": "已變更檔案",
          "when": "claudeInlineDiff.hasClaudeCode && !claude-code:doesNotSupportSecondarySidebar"
        }
      ],
      "claude-sidebar": [
        {
          "type": "webview",
          "id": "claudeInlineDiff.changedFilesInClaudeLegacy",
          "name": "已變更檔案",
          "when": "claudeInlineDiff.hasClaudeCode && claude-code:doesNotSupportSecondarySidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeInlineDiff.installHook",
        "title": "Claude Inline Diff: 安裝 Claude Code hook 到此工作區"
      },
      {
        "command": "claudeInlineDiff.acceptFile",
        "title": "Claude Inline Diff: 保留此檔案全部修改"
      },
      {
        "command": "claudeInlineDiff.rejectFile",
        "title": "Claude Inline Diff: 復原此檔案全部修改"
      },
      {
        "command": "claudeInlineDiff.acceptAll",
        "title": "Claude Inline Diff: 保留所有檔案的修改",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeInlineDiff.rejectAll",
        "title": "Claude Inline Diff: 復原所有檔案的修改",
        "icon": "$(discard)"
      },
      {
        "command": "claudeInlineDiff.nextHunk",
        "title": "Claude Inline Diff: 下一處修改"
      },
      {
        "command": "claudeInlineDiff.prevHunk",
        "title": "Claude Inline Diff: 上一處修改"
      },
      {
        "command": "claudeInlineDiff.listFiles",
        "title": "Claude Inline Diff: 列出所有待審查檔案"
      },
      {
        "command": "claudeInlineDiff.compareFile",
        "title": "Claude Inline Diff: 以 diff 檢視比對此檔案"
      },
      {
        "command": "claudeInlineDiff.startManualReview",
        "title": "Claude Inline Diff: 從目前內容開始追蹤此檔案（手動審查模式）"
      },
      {
        "command": "claudeInlineDiff.showDeleted",
        "title": "Claude Inline Diff: 顯示刪除內容"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeInlineDiff.showDeleted",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "claudeInlineDiff.acceptAll",
          "when": "view =~ /^claudeInlineDiff.changedFiles/",
          "group": "navigation@1"
        },
        {
          "command": "claudeInlineDiff.rejectAll",
          "when": "view =~ /^claudeInlineDiff.changedFiles/",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Claude Inline Diff",
      "properties": {
        "claudeInlineDiff.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "Claude 修改檔案後，自動在編輯器開啟該檔案並定位到修改處（預設關閉，可從「已變更檔案」清單開啟）"
        }
      }
    },
    "keybindings": [
      {
        "command": "claudeInlineDiff.acceptFile",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeInlineDiff.rejectFile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeInlineDiff.nextHunk",
        "key": "alt+f5",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeInlineDiff.prevHunk",
        "key": "shift+alt+f5",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "test": "npm run compile && node test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
